<Window x:Class="BsbInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="空降助手" Height="700" Width="1020" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧导航 -->
    <StackPanel Grid.Column="0" Margin="0,14,0,0">
      <TextBlock x:Name="VersionText" Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="22,8,0,16" />
      <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Content="总览" />
      <RadioButton x:Name="NavLaunch" Style="{StaticResource NavItem}" GroupName="nav" Content="启动方式" />
      <RadioButton x:Name="NavConfig" Style="{StaticResource NavItem}" GroupName="nav" Content="插件设置" />
      <RadioButton x:Name="NavMaint" Style="{StaticResource NavItem}" GroupName="nav" Content="维护" />
    </StackPanel>

    <!-- 右侧内容 -->
    <Grid Grid.Column="1" Margin="0,14,16,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

          <!-- ============================ 总览 ============================ -->
          <StackPanel x:Name="PageOverview">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="客户端" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Style="{StaticResource RowLabel}" Text="版本" />
                  <TextBlock x:Name="ClientVersion" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Style="{StaticResource RowLabel}" Text="安装目录" />
                  <TextBlock x:Name="ClientPath" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Style="{StaticResource RowLabel}" Text="客户端文件" />
                  <Border x:Name="AsarPill" Style="{StaticResource Pill}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="AsarDot" Style="{StaticResource Dot}" />
                      <TextBlock x:Name="AsarText" Margin="7,0,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Style="{StaticResource Btn}" Content="重新扫描" Click="OnClientScan" />
                  <Button Style="{StaticResource Btn}" Content="更改目录…" Click="OnClientPick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="运行状态" />
                <UniformGrid Columns="2" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource RowLabel}" Width="72" Text="注入器" />
                    <Border x:Name="InjectorPill" Style="{StaticResource Pill}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="InjectorDot" Style="{StaticResource Dot}" />
                        <TextBlock x:Name="InjectorText" Margin="7,0,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource RowLabel}" Width="72" Text="调试端口" />
                    <Border x:Name="PortPill" Style="{StaticResource Pill}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PortDot" Style="{StaticResource Dot}" />
                        <TextBlock x:Name="PortText" Margin="7,0,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource RowLabel}" Width="72" Text="登录自启" />
                    <Border x:Name="AutoPill" Style="{StaticResource Pill}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AutoDot" Style="{StaticResource Dot}" />
                        <TextBlock x:Name="AutoText" Margin="7,0,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource RowLabel}" Width="72" Text="托盘图标" />
                    <Border x:Name="TrayPill" Style="{StaticResource Pill}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="TrayDot" Style="{StaticResource Dot}" />
                        <TextBlock x:Name="TrayText" Margin="7,0,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource Btn}" Content="启动" Click="OnInjectorStart" />
                  <Button Style="{StaticResource Btn}" Content="停止" Click="OnInjectorStop" />
                  <Button Style="{StaticResource Btn}" Content="重启" Click="OnInjectorRestart" />
                  <Button Style="{StaticResource Btn}" Content="刷新" Click="OnRefresh" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="已打开的页面" />
                <ItemsControl x:Name="PageList" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="启用的类别" />
                <WrapPanel x:Name="CategoryChips" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================== 启动方式 ========================== -->
          <StackPanel x:Name="PageLaunch" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="调试端口" />
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="PortBox" Style="{StaticResource Input}" Width="90" Text="9222" />
                  <CheckBox x:Name="AllowOriginsBox" Style="{StaticResource Toggle}" Margin="18,0,0,0"
                            IsChecked="True" Content="附加 --remote-allow-origins=*" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="启动入口" />
                <ItemsControl x:Name="ShortcutList" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Style="{StaticResource BtnPrimary}" Content="应用到选中项" Click="OnShortcutsApply" />
                  <Button Style="{StaticResource Btn}" Content="移除调试端口" Click="OnShortcutsRemove" />
                  <TextBlock x:Name="ShortcutHint" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="登录自启" />
                <StackPanel Orientation="Horizontal">
                  <CheckBox x:Name="AutostartBox" Style="{StaticResource Toggle}" Content="登录时隐藏启动（托盘图标）"
                            Click="OnAutostartToggle" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================== 插件设置 ========================== -->
          <StackPanel x:Name="PageConfig" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="基本" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <CheckBox x:Name="CfgEnabled" Style="{StaticResource Toggle}" Content="启用跳过 / 静音" Margin="0,0,24,0" />
                  <CheckBox x:Name="CfgNotice" Style="{StaticResource Toggle}" Content="空降时显示提示" Margin="0,0,24,0" />
                  <CheckBox x:Name="CfgDebug" Style="{StaticResource Toggle}" Content="调试日志" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource RowLabel}" Text="API 地址" />
                  <TextBox x:Name="CfgApi" Style="{StaticResource Input}" Width="300" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="缓冲(秒)" />
                  <TextBox x:Name="CfgBuffer" Style="{StaticResource Input}" Width="70" />
                  <TextBlock Style="{StaticResource RowLabel}" Width="80" Margin="24,0,0,0" Text="最低赞数" />
                  <TextBox x:Name="CfgVotes" Style="{StaticResource Input}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="类别" />
                <ItemsControl x:Name="CategoryList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="动作" />
                <ItemsControl x:Name="ActionList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Button Style="{StaticResource BtnPrimary}" Content="保存" Click="OnConfigSave" />
              <Button Style="{StaticResource Btn}" Content="重新读取" Click="OnRefresh" />
              <TextBlock x:Name="ConfigSaved" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- =========================== 维护 ============================ -->
          <StackPanel x:Name="PageMaint" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="插件更新" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Style="{StaticResource RowLabel}" Text="当前版本" />
                  <TextBlock x:Name="UpdCurrent" />
                  <TextBlock Style="{StaticResource RowLabel}" Width="90" Margin="24,0,0,0" Text="最新版本" />
                  <TextBlock x:Name="UpdLatest" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Button Style="{StaticResource BtnPrimary}" Content="检查更新" Click="OnUpdateCheck" />
                  <Button Style="{StaticResource Btn}" Content="自动更新" Click="OnUpdateAuto" />
                  <CheckBox x:Name="UpdAutoCheck" Style="{StaticResource Toggle}" Margin="18,0,0,0"
                            Content="打开安装器时自动检查" Checked="OnUpdateAutoToggle" Unchecked="OnUpdateAutoToggle" />
                </StackPanel>
                <TextBlock x:Name="UpdHint" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="从本地安装" />
                <WrapPanel>
                  <Button Style="{StaticResource Btn}" Content="用仓库 payload" Click="OnUpdateRepo" />
                  <Button Style="{StaticResource Btn}" Content="选择目录…" Click="OnUpdateFolder" />
                  <Button Style="{StaticResource Btn}" Content="选择 zip…" Click="OnUpdateZip" />
                </WrapPanel>
                <TextBlock x:Name="PickedPath" Foreground="{StaticResource FaintBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="客户端" />
                <WrapPanel>
                  <Button Style="{StaticResource Btn}" Content="一键适配" Click="OnPatch" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="托盘图标" />
                <WrapPanel>
                  <Button Style="{StaticResource Btn}" Content="启动" Click="OnTrayStart" />
                  <Button Style="{StaticResource Btn}" Content="停止" Click="OnTrayStop" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="其他" />
                <WrapPanel>
                  <Button Style="{StaticResource Btn}" Content="打开日志" Click="OnOpenLogs" />
                  <Button Style="{StaticResource Btn}" Content="打开项目目录" Click="OnOpenProject" />
                  <Button Style="{StaticResource Btn}" Content="复制诊断信息" Click="OnCopyDiagnostics" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- 底部状态条 -->
      <Border Grid.Row="1" Margin="0,8,0,12" Padding="12,7" CornerRadius="6"
              Background="#12FFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Style="{StaticResource Dot}" Fill="{StaticResource FaintBrush}" />
          <TextBlock x:Name="StatusText" Margin="8,0,0,0" Foreground="{StaticResource DimBrush}"
                     Text="就绪" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
