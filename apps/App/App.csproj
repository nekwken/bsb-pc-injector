<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- 一个 exe 同时承载托盘与设置窗口：WPF 负责窗口，WinForms 负责 NotifyIcon -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BSB</AssemblyName>
    <RootNamespace>BsbApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>..\Assets\bsb.ico</ApplicationIcon>
    <!-- 自己写 Main：要解析启动参数与单实例 -->
    <StartupObject>BsbApp.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms SDK 会把这些塞进全局 using，和 WPF 的 Application/CheckBox/Color 等撞名；
         只有 Tray.cs 需要它们，那里显式引入即可 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Tray.cs" />
    <Compile Include="Backend.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 上游插件（GPL-3.0）自带的图标。
         ico 作为 exe 的文件图标（资源管理器会按需选帧）；
         窗口/任务栏图标用 256px 原图——WPF 的 BitmapImage 只解码 ico 的第 0 帧（16px），
         任务栏会把 16px 放大到 32px，又糊又显小。 -->
    <Resource Include="..\Assets\bsb.ico" Link="Assets/bsb.ico" />
    <Resource Include="..\Assets\bsb-256.png" Link="Assets/bsb-256.png" />
  </ItemGroup>

</Project>
